#!/usr/bin/env bash
set -euo pipefail
dot() {
  /usr/bin/git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME" "$@"
}
git clone --bare https://github.com/racakenon/dotfiles-contents $HOME/.dotfiles
dot checkout
dot config --local status.showUntrackedFiles nO

mkdir -p "$HOME/.local/bin"
mkdir -p "$HOME/.local/source"

if ! command -v rustup >/dev/null 2>&1; then
	curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
fi

if [ -f "$HOME/.cargo/env" ]; then
	. "$HOME/.cargo/env"
fi

cargo install sccache

export RUSTC_WRAPPER=sccache
export CC="sc-gcc"
export CXX="sc-g++"

cargo install cargo-update
cargo install eza
cargo install fd-find
cargo install fnm
cargo install ripgrep
cargo install starship
cargo install vivid
cargo install zoxide
cargo install --git https://github.com/astral-sh/uv uv

SCRIPT_DIR=$(dirname "$0")

"$SCRIPT_DIR/install-fonts"
"$SCRIPT_DIR/install-packages"

export RUSTC_WRAPPER=sccache
export CC="sc-gcc"
export CXX="sc-g++"

# Build: alacritty (Wayland only)
echo "==> Building alacritty..."
cd "$HOME/.local/source/alacritty"
cargo build --release --no-default-features --features=wayland

# Build: niri
echo "==> Building niri..."
cd "$HOME/.local/source/niri"
cargo build --release --no-default-features --features dbus --features pipewire
sudo install -Dm755 resources/niri-session                       /usr/local/bin/niri-session
sudo install -Dm644 resources/niri.desktop                       /usr/local/share/wayland-sessions/niri.desktop
sudo install -Dm644 resources/niri-portals.conf                  /usr/local/share/xdg-desktop-portal/niri-portals.conf
sudo install -Dm644 resources/niri.service                       /etc/systemd/user/niri.service
sudo install -Dm644 resources/niri-shutdown.target               /etc/systemd/user/niri-shutdown.target

# Build: awww
echo "==> Building awww..."
cd "$HOME/.local/source/awww"
cargo build --release

# Build: sirula
echo "==> Building sirula..."
cd "$HOME/.local/source/sirula"
cargo build --release

# Symlink binaries to ~/.local/bin
echo "==> Linking binaries..."
ln -sf "$HOME/.local/source/niri/target/release/niri"             "$HOME/.local/bin/niri"
ln -sf "$HOME/.local/source/alacritty/target/release/alacritty"   "$HOME/.local/bin/alacritty"
ln -sf "$HOME/.local/source/awww/target/release/awww"             "$HOME/.local/bin/awww"
ln -sf "$HOME/.local/source/awww/target/release/awww-daemon"      "$HOME/.local/bin/awww-daemon"
ln -sf "$HOME/.local/source/sirula/target/release/sirula"         "$HOME/.local/bin/sirula"
